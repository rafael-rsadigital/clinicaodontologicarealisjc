---
import Layout from '../layouts/Layout.astro';
const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const canonical = `${siteUrl}/estetica-e-harmonizacao`;

const faqSchema = [
  {
    question: 'Quanto tempo dura a harmonização orofacial?',
    answer: 'Os resultados com ácido hialurônico duram em média 12 a 18 meses, dependendo do produto utilizado, do metabolismo do paciente e da região tratada. A toxina botulínica dura de 4 a 6 meses.'
  },
  {
    question: 'Harmonização orofacial é segura?',
    answer: 'Sim, quando realizada por profissional habilitado pelo CFO com produtos registrados na ANVISA. Na Clínica Reali, todos os procedimentos são realizados pela Dra. Gabriela, cirurgiã-dentista capacitada, com protocolos de segurança e materiais certificados.'
  },
  {
    question: 'Qual a diferença entre lente de contato dental e faceta de resina?',
    answer: 'As lentes de contato dental são lâminas de porcelana ultrafinas (0,2 a 0,5 mm) confeccionadas em laboratório, com resultado mais estético e duradouro (10 a 15 anos). As facetas de resina são aplicadas diretamente no consultório, com custo menor e resultado excelente, mas com durabilidade menor (5 a 7 anos com boa higiene).'
  },
  {
    question: 'Quanto tempo dura o clareamento dental?',
    answer: 'O clareamento a laser em consultório produz resultados imediatos (em 1 sessão). O clareamento caseiro supervisionado leva de 2 a 4 semanas. Em ambos os casos, o resultado dura de 1 a 3 anos, dependendo da dieta e hábitos do paciente.'
  },
  {
    question: 'O preenchimento labial deixa os lábios artificiais?',
    answer: 'Não, quando realizado de forma técnica e conservadora. Na Clínica Reali, o foco é sempre o proporções faciais e características individuais do paciente Trabalhamos com ácido hialurônico de alta qualidade, aplicado com critério e respeito às proporções do rosto.'
  }
];

const procedures = [
  {
    id: 'harmonizacao-orofacial',
    h2: 'Harmonização Orofacial em São José dos Campos',
    content: `A Harmonização Orofacial (HOF) é o conjunto de procedimentos minimamente invasivos que equilibram as proporções do rosto, suavizam sinais de expressão e realçam a beleza natural de cada paciente. Na Clínica Reali em SJC, a Dra. Gabriela realiza:

Preenchimento Labial — utiliza ácido hialurônico para aumentar o volume dos lábios, definir o contorno e corrigir assimetrias de forma gradual e natural.

Rinomodelação — corrige imperfeições na aparência do nariz (irregularidades estéticas do contorno nasal) com preenchimento de ácido hialurônico, sem cirurgia.

Full Face — protocolo completo que trabalha o rosto como um todo: sulcos, volume em maçãs do rosto, mandíbula, queixo e área temporal.

Bioestimuladores de Colágeno — substâncias como Sculptra e Radiesse estimulam a produção natural de colágeno, promovendo rejuvenescimento gradual e duradouro com melhora na qualidade da pele.

Toxina Botulínica — relaxa músculos de expressão para suavizar rugas e é também utilizada no tratamento do bruxismo.

Todos os procedimentos são realizados por profissional habilitada pelo CFO, com produtos registrados na ANVISA.`
  },
  {
    id: 'facetas-lentes',
    h2: 'Facetas de Resina e Lentes de Contato Dental',
    content: `Facetas de Resina Composta são lâminas aplicadas diretamente sobre os dentes para corrigir cor, forma, tamanho e posição. O procedimento pode ser realizado diretamente no consultório e a indicação depende da condição dos dentes e do resultado desejado. Ideal para quem busca melhora estética com resultado imediato.

Lentes de Contato Dental (porcelana) são restaurações cerâmicas ultrafinas com espessura entre 0,2 e 0,5 mm. Confeccionadas em laboratório por ceramistas especializados, corrigem cor intrínseca (fluorose, manchas), diastemas, dentes desgastados ou quebrados e pequenos apinhamentos. São indicadas para alterações de forma, cor e proporção, conforme avaliação do caso.

Na Clínica Reali, o planejamento é feito com Digital Smile Design (DSD): você visualiza o resultado esperado antes de qualquer procedimento, garantindo alinhamento entre expectativas e tratamento.`
  },
  {
    id: 'clareamento',
    h2: 'Clareamento Dental em São José dos Campos',
    content: `Clareamento a Laser (Consultório) — realizado em sessão de aproximadamente 1 hora, com gel clareador de alta concentração ativado por luz LED. A resposta ao clareamento varia conforme a cor inicial dos dentes, o produto utilizado e as características de cada paciente.

Clareamento Caseiro Supervisionado — o paciente utiliza moldeiras personalizadas com gel de baixa concentração em casa, por 2 a 4 semanas, conforme prescrição. Resultados progressivos com menor sensibilidade.

Clareamento Combinado — associação das duas técnicas para resultados otimizados e mais duradouros.

Importante: o clareamento atua apenas em estrutura dental natural. Restaurações de resina ou porcelana em região visível precisarão ser substituídas para harmonizar com o novo tom. A avaliação prévia é indispensável.`
  },
  {
    id: 'gengivoplastia',
    h2: 'Gengivoplastia — Remodelação do Contorno Gengival',
    content: `A gengivoplastia remodela o tecido gengival para criar um contorno mais harmonioso e estético. É indicada principalmente para o sorriso gengival — onde a gengiva aparece excessivamente ao sorrir — e para correção de assimetrias no contorno gengival.

O procedimento é realizado com laser de diodo ou bisturi cirúrgico, removendo o excesso de tecido e, quando necessário, nivelando o osso subjacente (osteotomia). A recuperação é rápida (3 a 7 dias) com desconforto leve controlado com analgésicos.

A gengivoplastia frequentemente complementa outros tratamentos estéticos — facetas, lentes de contato e clareamento — integrando um projeto completo de transformação do sorriso.`
  }
];
---

<Layout
  title="Harmonização Orofacial e Estética Dental em São José dos Campos"
  description="Harmonização Orofacial, Lentes de Contato Dental, Facetas de Resina, Clareamento Dental e Gengivoplastia em São José dos Campos — SP. Dra. Gabriela. Clínica Reali, Vila Adyana. (12) 99184-3883."
  canonical={canonical}
  {faqSchema}
>
  <!-- HERO -->
  <section class="bg-slate-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <nav class="text-slate-500 text-xs mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-300">Início</a>
          <span class="mx-1">/</span>
          <span class="text-slate-300">Estética e Harmonização</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4">
          Harmonização Orofacial e<br/>
          <span class="text-emerald-400">Estética Dental em SJC</span>
        </h1>
        <p class="text-slate-300 leading-relaxed mb-6">
          Procedimentos estéticos minimamente invasivos realizados por profissional habilitada pelo CFO. Planejamento individualizado em São José dos Campos.
        </p>
        <a
          href="https://wa.me/5512991843883?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20sobre%20harmoniza%C3%A7%C3%A3o%20orofacial%20e%20est%C3%A9tica%20dental!"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Agendar Avaliação
        </a>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Destaque -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-12">
        <h2 class="text-slate-900 font-semibold mb-3">Diferenciais da Clínica Reali em estética dental</h2>
        <ul class="space-y-2 text-slate-600 text-sm">
          {[
            'Profissional habilitada pelo CFO para harmonização orofacial',
            'Produtos registrados na ANVISA',
            'Planejamento com Digital Smile Design (DSD)',
            'Planejamento individualizado para cada procedimento',
            'Avaliação personalizada sem compromisso'
          ].map(item => (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Procedimentos -->
      <div class="space-y-14">
        {procedures.map((proc, index) => (
          <article id={proc.id}>
            <h2 class="text-2xl font-bold text-slate-900 mb-4">{proc.h2}</h2>
            <div class="text-slate-600 leading-relaxed whitespace-pre-line">{proc.content}</div>
            {index < procedures.length - 1 && <hr class="mt-12 border-slate-100"/>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-emerald-700 text-sm font-semibold uppercase tracking-wider mb-2">FAQ</p>
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Perguntas sobre estética dental e harmonização orofacial</h2>
      <div class="space-y-1">
        {faqSchema.map((item) => (
          <div class="faq-item border border-slate-200 rounded-xl overflow-hidden bg-white">
            <button class="faq-question w-full flex items-center justify-between gap-4 px-5 py-4 text-left text-slate-800 font-medium hover:bg-slate-50 transition-colors" aria-expanded="false">
              <span>{item.question}</span>
              <svg class="faq-icon w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
            </button>
            <div class="faq-answer hidden px-5 pb-4">
              <p class="text-slate-600 text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-14 bg-slate-900">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Pronto para transformar seu sorriso?</h2>
      <p class="text-slate-400 mb-6">Agende uma avaliação com a Dra. Gabriela na Clínica Reali em São José dos Campos.</p>
      <a
        href="https://wa.me/5512991843883?text=Ol%C3%A1%2C%20tenho%20interesse%20em%20tratamentos%20est%C3%A9ticos%20na%20Cl%C3%ADnica%20Reali!"
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        Agendar pelo WhatsApp
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling as HTMLElement | null;
        const icon = btn.querySelector('.faq-icon') as HTMLElement | null;
        const isOpen = answer && !answer.classList.contains('hidden');
        document.querySelectorAll('.faq-answer').forEach(a => (a as HTMLElement).classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(ic => { (ic as HTMLElement).style.transform = 'rotate(0deg)'; });
        document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded', 'false'));
        if (!isOpen && answer) {
          answer.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(45deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</Layout>
