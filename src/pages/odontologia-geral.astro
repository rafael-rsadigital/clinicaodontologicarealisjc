---
import Layout from '../layouts/Layout.astro';
const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const canonical = `${siteUrl}/odontologia-geral`;

const faqSchema = [
  {
    question: 'A Clínica Reali atende crianças?',
    answer: 'Sim. Oferecemos atendimento de odontopediatria com consulta inicial infantil especializada. Nossa equipe é treinada para criar uma experiência positiva e acolhedora para as crianças desde a primeira visita.'
  },
  {
    question: 'O que é periodontite e como é tratada?',
    answer: 'A periodontite é uma infecção grave das gengivas que compromete o osso de suporte dos dentes. O tratamento inclui raspagem e alisamento radicular (limpeza profunda abaixo da gengiva) e, em casos avançados, cirurgia periodontal. Após o tratamento, é essencial a manutenção periodontal periódica.'
  },
  {
    question: 'Quanto tempo dura o tratamento ortodôntico?',
    answer: 'O tempo médio varia de 18 a 36 meses, dependendo da complexidade do caso. Alinhadores invisíveis podem ter duração semelhante ou menor para casos mais simples. A avaliação ortodôntica define o plano e o tempo estimado de tratamento.'
  },
  {
    question: 'O tratamento de canal dói?',
    answer: 'Não. O tratamento endodôntico (canal) é realizado sob anestesia local, sem dor durante o procedimento. É um tratamento que alivia a dor causada pela inflamação ou infecção da polpa dental.'
  },
  {
    question: 'A Clínica Reali trata bruxismo?',
    answer: 'Sim. O bruxismo (hábito de apertar ou ranger os dentes) é tratado com placa miorrelaxante personalizada e, quando indicado, com aplicação de toxina botulínica nos masseteres para reduzir a intensidade dos episódios.'
  }
];

const categories = [
  {
    id: 'clinico-preventivo',
    title: 'Clínico e Preventivo',
    intro: 'A base de uma boa saúde bucal está na prevenção e no diagnóstico precoce. Realizamos avaliações completas e tratamentos conservadores para manter a saúde dos seus dentes a longo prazo.',
    services: [
      { name: 'Avaliação e Planejamento Odontológico', desc: 'Consulta diagnóstica com anamnese, exame clínico, radiográfico e elaboração de plano de tratamento personalizado.' },
      { name: 'Orientação de Higiene Bucal', desc: 'Técnicas corretas de escovação, uso do fio dental e produtos adequados ao perfil de cada paciente.' },
      { name: 'Tratamento de Cárie', desc: 'Remoção do tecido comprometido e restauração com materiais biocompatíveis de alta resistência.' },
      { name: 'Restauração em Resina Composta', desc: 'Restaurações estéticas e funcionais com resina de última geração, combinando cor e durabilidade.' },
      { name: 'Selante Dental', desc: 'Proteção preventiva de fissuras e sulcos em dentes posteriores para prevenir cárie.' },
      { name: 'Aplicação de Flúor', desc: 'Aplicação tópica para fortalecer o esmalte dental e prevenir cárie, especialmente indicado para crianças.' },
    ]
  },
  {
    id: 'odontopediatria',
    title: 'Odontopediatria — Atendimento Infantil',
    intro: 'Cuidamos do sorriso das crianças com uma abordagem lúdica e acolhedora, criando desde cedo uma relação positiva com o dentista.',
    services: [
      { name: 'Primeira Consulta Infantil', desc: 'Atendimento especializado para crianças desde os primeiros dentes, com abordagem acolhedora e sem traumas.' },
      { name: 'Prevenção na Infância', desc: 'Selantes, flúor, orientações de higiene para os pais e acompanhamento do desenvolvimento da dentição.' },
      { name: 'Restaurações em Dentes de Leite', desc: 'Tratamento de cárie em dentes de leite com técnicas adaptadas ao atendimento pediátrico.' },
      { name: 'Espaço Mantenedor', desc: 'Dispositivo que preserva o espaço para os dentes permanentes quando há perda precoce de dentes de leite.' },
    ]
  },
  {
    id: 'especialidades',
    title: 'Especialidades Odontológicas',
    intro: 'Tratamentos especializados que complementam a odontologia geral, abordando desde problemas funcionais até reabilitações complexas.',
    services: [
      { name: 'Tratamento de Bruxismo', desc: 'Placa miorrelaxante personalizada e, quando indicado, toxina botulínica nos masseteres para reduzir a intensidade do bruxismo.' },
      { name: 'Prótese Parcial Removível', desc: 'Prótese removível para substituição de um ou mais dentes ausentes, em acrílico ou metálica (esquelética).' },
      { name: 'Prótese Total (Dentadura)', desc: 'Próteses totais convencionais e sobre implantes, com ajustes personalizados para máximo conforto.' },
      { name: 'Exodontia Simples', desc: 'Extração de dentes com comprometimento irreversível, com técnica minimamente invasiva.' },
      { name: 'Exodontia de Siso', desc: 'Remoção de terceiros molares inclusos ou semi-inclusos com planejamento tomográfico prévio.' },
      { name: 'Endodontia — Tratamento de Canal', desc: 'Tratamento do canal radicular para salvar dentes com comprometimento pulpar, utilizando instrumentação mecanizada.' },
      { name: 'Retratamento Endodôntico', desc: 'Novo tratamento de canal em dentes com falha no tratamento anterior, com localização eletrônica dos canais.' },
    ]
  },
  {
    id: 'ortodontia',
    title: 'Ortodontia',
    intro: 'Correção do posicionamento dos dentes e da relação entre as arcadas dentárias, com opções que vão do aparelho fixo convencional aos alinhadores invisíveis.',
    services: [
      { name: 'Aparelho Ortodôntico Fixo Metálico', desc: 'Tratamento ortodôntico convencional com bráquetes metálicos de alta performance para correção de má-oclusão e apinhamentos.' },
      { name: 'Aparelho Fixo Estético (Cerâmico ou Safira)', desc: 'Mesma eficácia do aparelho metálico com bráquetes que se confundem com a cor dos dentes.' },
      { name: 'Alinhadores Invisíveis', desc: 'Tratamento com placas plásticas transparentes e removíveis, trocadas periodicamente. Praticamente invisível e sem bráquetes.' },
      { name: 'Contenção Ortodôntica', desc: 'Dispositivos fixos ou removíveis usados após o tratamento para manter a posição dos dentes.' },
    ]
  },
  {
    id: 'periodontia',
    title: 'Periodontia',
    intro: 'Prevenção e tratamento das doenças que afetam a gengiva e o osso de suporte dos dentes. A saúde periodontal é fundamental para a longevidade dos dentes naturais e dos implantes.',
    services: [
      { name: 'Raspagem e Alisamento Radicular', desc: 'Limpeza profunda abaixo da gengiva para remover tártaro e biofilme causadores da periodontite.' },
      { name: 'Cirurgia Periodontal', desc: 'Acesso cirúrgico a bolsas profundas para redução de bolsas e regeneração de tecido de suporte.' },
      { name: 'Tratamento de Gengivite', desc: 'Controle da inflamação gengival inicial com profilaxia, orientação e acompanhamento.' },
      { name: 'Tratamento de Periodontite', desc: 'Tratamento da inflamação avançada que compromete osso e ligamento periodontal.' },
      { name: 'Enxerto Gengival', desc: 'Cobertura de raízes expostas e aumento da faixa de gengiva queratinizada.' },
      { name: 'Manutenção Periodontal', desc: 'Acompanhamento periódico para pacientes com histórico de doença periodontal.' },
      { name: 'Tratamento de Periimplantite', desc: 'Tratamento da inflamação ao redor de implantes dentários para preservar a osseointegração.' },
      { name: 'Regeneração Óssea Guiada (ROG)', desc: 'Reconstrução de osso perdido por periodontite com membranas e enxertos ósseos.' },
      { name: 'Corticotomia para Ortodontia', desc: 'Procedimento cirúrgico que acelera o movimento dentário durante tratamento ortodôntico.' },
    ]
  }
];
---

<Layout
  title="Odontologia em São José dos Campos — Tratamentos Completos | Clínica Reali"
  description="Odontologia geral completa em São José dos Campos — SP: prevenção, restauração, canal, ortodontia, periodontia, odontopediatria e mais. Clínica Reali, Vila Adyana. (12) 99184-3883."
  canonical={canonical}
  {faqSchema}
>
  <!-- HERO -->
  <section class="bg-slate-900 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <nav class="text-slate-500 text-xs mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-300">Início</a>
          <span class="mx-1">/</span>
          <span class="text-slate-300">Odontologia Geral</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4">
          Odontologia em São José dos Campos<br/>
          <span class="text-emerald-400">Tratamentos Completos</span>
        </h1>
        <p class="text-slate-300 leading-relaxed mb-6">
          Da prevenção às especialidades avançadas — todos os tratamentos que você precisa em uma única clínica, no bairro Vila Adyana, SJC.
        </p>
        <a
          href="https://wa.me/5512991843883?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20consulta!"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Agendar Consulta
        </a>
      </div>
    </div>
  </section>

  <!-- CATÁLOGO -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Navegação por categoria -->
      <nav class="flex flex-wrap gap-2 mb-12" aria-label="Navegar por categoria">
        {categories.map(cat => (
          <a
            href={`#${cat.id}`}
            class="inline-flex items-center px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-emerald-300 hover:text-emerald-700 text-sm font-medium transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </nav>

      <div class="space-y-20">
        {categories.map(cat => (
          <div id={cat.id}>
            <div class="mb-6 pb-6 border-b border-slate-200">
              <h2 class="text-2xl font-bold text-slate-900 mb-2">{cat.title}</h2>
              <p class="text-slate-500 text-sm leading-relaxed max-w-2xl">{cat.intro}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {cat.services.map(service => (
                <div class="border border-slate-200 rounded-xl p-5 bg-white hover:border-emerald-200 hover:bg-slate-50 transition-all">
                  <h3 class="text-slate-900 font-semibold text-sm mb-1.5">{service.name}</h3>
                  <p class="text-slate-500 text-sm leading-relaxed">{service.desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-emerald-700 text-sm font-semibold uppercase tracking-wider mb-2">FAQ</p>
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Perguntas frequentes sobre odontologia geral</h2>
      <div class="space-y-1">
        {faqSchema.map((item) => (
          <div class="faq-item border border-slate-200 rounded-xl overflow-hidden bg-white">
            <button class="faq-question w-full flex items-center justify-between gap-4 px-5 py-4 text-left text-slate-800 font-medium hover:bg-slate-50 transition-colors" aria-expanded="false">
              <span>{item.question}</span>
              <svg class="faq-icon w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
            </button>
            <div class="faq-answer hidden px-5 pb-4">
              <p class="text-slate-600 text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-14 bg-slate-900">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Não encontrou o que procura?</h2>
      <p class="text-slate-400 mb-6">Entre em contato e nossa equipe te orienta sobre o melhor tratamento para a sua necessidade.</p>
      <a
        href="https://wa.me/5512991843883?text=Ol%C3%A1%2C%20gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20tratamentos!"
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        Falar no WhatsApp
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling as HTMLElement | null;
        const icon = btn.querySelector('.faq-icon') as HTMLElement | null;
        const isOpen = answer && !answer.classList.contains('hidden');
        document.querySelectorAll('.faq-answer').forEach(a => (a as HTMLElement).classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(ic => { (ic as HTMLElement).style.transform = 'rotate(0deg)'; });
        document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded', 'false'));
        if (!isOpen && answer) {
          answer.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(45deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</Layout>
