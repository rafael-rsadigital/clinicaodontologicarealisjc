---
import Layout from '../layouts/Layout.astro';
const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const canonical = `${siteUrl}/urgencia-24h`;

const faqSchema = [
  {
    question: 'O plantão odontológico 24h funciona mesmo de madrugada?',
    answer: 'Sim. O atendimento de urgência da Clínica Reali funciona 24 horas por dia, 7 dias por semana, incluindo madrugadas, feriados e fins de semana. O contato inicial é feito via WhatsApp: (12) 99184-3883.'
  },
  {
    question: 'O que fazer quando um dente é arrancado por trauma?',
    answer: 'Preserve o dente em leite integral, soro fisiológico ou na saliva do próprio paciente — nunca em água. Procure atendimento odontológico de urgência em até 30 a 60 minutos para que o reimplante seja viável. Entre em contato conosco imediatamente pelo (12) 99184-3883.'
  },
  {
    question: 'Abscesso dentário é emergência?',
    answer: 'Sim. O abscesso dentário é uma infecção grave que pode se espalhar rapidamente e causar complicações sérias. Procure atendimento de urgência imediatamente, especialmente se houver inchaço progressivo, febre, ou dificuldade de respirar ou engolir.'
  },
  {
    question: 'Qual o endereço da Clínica Reali para urgências em SJC?',
    answer: 'R. Cel. João Cursino, 185, Vila Adyana, São José dos Campos — SP, CEP 12243-680. Recomendamos contato prévio via WhatsApp (12) 99184-3883 para confirmar disponibilidade de atendimento.'
  }
];

const emergencies = [
  { title: 'Dor de Dente Intensa', desc: 'Dor aguda, pulsante ou contínua que não cede com analgésico. Avaliamos e tratamos a causa na mesma consulta.' },
  { title: 'Abscesso Dentário', desc: 'Infecção grave com inchaço, pus e febre. Exige drenagem e antibioticoterapia de forma imediata.' },
  { title: 'Dente Fraturado', desc: 'Fratura por queda, acidente ou mordida. Quanto mais rápido o atendimento, mais preservamos a estrutura dental.' },
  { title: 'Dente Avulsionado', desc: 'Dente completamente arrancado por trauma. O reimplante é possível em até 60 minutos — entre em contato agora.' },
  { title: 'Pericoronarite', desc: 'Inflamação ao redor do siso em erupção. Causa dor intensa, dificuldade de abrir a boca e, em alguns casos, febre.' },
  { title: 'Trauma Dental', desc: 'Quedas, acidentes ou impactos que causam mobilidade, luxação ou deslocamento dental. Avaliação radiográfica imediata.' },
];
---

<Layout
  title="Dentista de Urgência 24 Horas em São José dos Campos | Clínica Reali"
  description="Dor de dente em SJC? A Clínica Reali oferece atendimento odontológico de urgência 24 horas — madrugadas, feriados e fins de semana. Vila Adyana, São José dos Campos. WhatsApp: (12) 99184-3883."
  canonical={canonical}
  {faqSchema}
>
  <!-- HERO -->
  <section class="bg-red-950 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <nav class="text-red-400 text-xs mb-4 opacity-70" aria-label="Breadcrumb">
          <a href="/" class="hover:text-red-200">Início</a>
          <span class="mx-1">/</span>
          <span class="text-red-300">Urgência 24h</span>
        </nav>

        <div class="inline-flex items-center gap-2 text-red-300 text-xs font-medium border border-red-800 bg-red-900/50 px-3 py-1 rounded-full mb-6">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-400"></span>
          </span>
          Plantão ativo agora
        </div>

        <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4">
          Dentista de Urgência<br/>
          <span class="text-red-400">24 Horas em SJC</span>
        </h1>

        <p class="text-red-100 text-lg leading-relaxed mb-8">
          Dor de dente, abscesso, dente quebrado ou trauma dental em São José dos Campos? Nossa equipe atende emergências odontológicas a qualquer hora — incluindo madrugadas, feriados e fins de semana.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="https://wa.me/5512991843883?text=URG%C3%8ANCIA%20-%20Preciso%20de%20atendimento%20odontol%C3%B3gico%20de%20emerg%C3%AAncia!"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-6 py-3.5 rounded-lg transition-colors text-lg"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Chamar no WhatsApp
          </a>
          <a
            href="tel:+5512991843883"
            class="inline-flex items-center justify-center gap-2 border border-red-700 text-red-200 hover:bg-red-900 font-semibold px-6 py-3.5 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            (12) 99184-3883
          </a>
        </div>

        <p class="mt-6 text-red-400 text-sm">R. Cel. João Cursino, 185 — Vila Adyana, São José dos Campos — SP</p>
      </div>
    </div>
  </section>

  <!-- SITUAÇÕES ATENDIDAS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-red-600 text-sm font-semibold uppercase tracking-wider mb-2">Cobertura de urgências</p>
        <h2 class="text-2xl font-bold text-slate-900">Situações atendidas no plantão 24h</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {emergencies.map(item => (
          <div class="border border-slate-200 rounded-xl p-5 bg-white hover:border-red-200 transition-colors">
            <h3 class="text-slate-900 font-semibold mb-1.5">{item.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Como funciona o atendimento de urgência</h2>
      <div class="space-y-6">
        {[
          {
            title: 'Contato via WhatsApp ou telefone',
            desc: 'O primeiro passo é entrar em contato via WhatsApp (12) 99184-3883. Nossa equipe avalia a situação e agenda o atendimento com prioridade de acordo com a urgência do caso.'
          },
          {
            title: 'Avaliação e diagnóstico imediato',
            desc: 'Na chegada à clínica, realizamos exame clínico e radiográfico para diagnosticar a causa da dor ou emergência. O diagnóstico correto é essencial para o tratamento adequado.'
          },
          {
            title: 'Alívio imediato da dor',
            desc: 'Priorizamos o alívio da dor antes de qualquer procedimento definitivo. A partir do diagnóstico, tratamos a causa e prescrevemos a medicação necessária.'
          },
          {
            title: 'Planejamento do tratamento definitivo',
            desc: 'Após o atendimento de urgência, apresentamos o plano de tratamento completo para resolver a causa do problema de forma definitiva e evitar recidivas.'
          },
        ].map(item => (
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-red-100 border border-red-200 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h3 class="text-slate-900 font-semibold mb-1">{item.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-red-600 text-sm font-semibold uppercase tracking-wider mb-2">FAQ</p>
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Dúvidas sobre urgência odontológica em SJC</h2>
      <div class="space-y-1">
        {faqSchema.map((item) => (
          <div class="faq-item border border-slate-200 rounded-xl overflow-hidden bg-white">
            <button class="faq-question w-full flex items-center justify-between gap-4 px-5 py-4 text-left text-slate-800 font-medium hover:bg-slate-50 transition-colors" aria-expanded="false">
              <span>{item.question}</span>
              <svg class="faq-icon w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
            </button>
            <div class="faq-answer hidden px-5 pb-4">
              <p class="text-slate-600 text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-14 bg-red-950">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Está com dor agora?</h2>
      <p class="text-red-200 mb-6">Não espere até amanhã. Nossa equipe está de plantão.</p>
      <a
        href="https://wa.me/5512991843883?text=URG%C3%8ANCIA%20-%20Preciso%20de%20atendimento%20odontol%C3%B3gico%20agora!"
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-8 py-4 rounded-lg transition-colors text-lg"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Chamar no WhatsApp Agora
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling as HTMLElement | null;
        const icon = btn.querySelector('.faq-icon') as HTMLElement | null;
        const isOpen = answer && !answer.classList.contains('hidden');
        document.querySelectorAll('.faq-answer').forEach(a => (a as HTMLElement).classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(ic => { (ic as HTMLElement).style.transform = 'rotate(0deg)'; });
        document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded', 'false'));
        if (!isOpen && answer) {
          answer.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(45deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</Layout>
