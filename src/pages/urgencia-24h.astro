---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const canonical = `${siteUrl}/urgencia-24h`;

const emergencies = [
  { icon: '🦷', title: 'Dor de Dente Intensa', desc: 'Dor aguda ou pulsante que não passa com analgésico. Atendemos imediatamente.' },
  { icon: '🔴', title: 'Abscesso Dentário', desc: 'Inflamação grave com pus, inchaço e febre. Requer tratamento urgente.' },
  { icon: '💔', title: 'Fratura Dental', desc: 'Dente quebrado por queda ou acidente. Quanto mais rápido, mais chances de recuperação.' },
  { icon: '⚡', title: 'Reimplante Pós-Trauma', desc: 'Dente avulsionado (arrancado)? Guarde em leite e venha em até 1 hora — podemos reimplantar.' },
  { icon: '🩹', title: 'Pericoronarite', desc: 'Inflamação no siso em erupção, com dor, inchaço e dificuldade de abrir a boca.' },
  { icon: '🔥', title: 'Herpes Labial Severo', desc: 'Lesões dolorosas que exigem tratamento odontológico especializado.' },
];
---

<Layout
  title="Dentista de Urgência 24h em São José dos Campos | Clínica Reali"
  description="Dor de dente de madrugada em SJC? Clínica Reali com atendimento de urgência odontológica 24 horas. Abscesso, fratura dental, trauma — chame no WhatsApp agora!"
  canonical={canonical}
>
  <!-- HERO DE URGÊNCIA — Fundo escuro vermelho -->
  <section class="bg-gradient-to-br from-red-950 via-red-900 to-navy-900 min-h-screen flex items-center relative overflow-hidden">
    <!-- Elementos visuais de alerta -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-red-500 animate-pulse"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(220,38,38,0.2),transparent_70%)]"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <!-- Badge piscando -->
      <div class="flex justify-center mb-6">
        <div class="inline-flex items-center gap-3 bg-red-600 border border-red-400 text-white font-bold px-5 py-2.5 rounded-full text-sm uppercase tracking-widest animate-pulse">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-300 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
          </span>
          PLANTÃO ATIVO AGORA — 24 HORAS
        </div>
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-4 leading-tight">
        Urgência<br/>
        <span class="text-red-400">Odontológica</span><br/>
        <span class="text-white">24 Horas</span>
      </h1>

      <p class="text-red-100 text-xl md:text-2xl font-medium mb-4">
        São José dos Campos — SP
      </p>

      <p class="text-slate-300 text-lg max-w-2xl mx-auto mb-10">
        Está com dor de dente? Abscesso? Dente quebrado? <strong class="text-white">Não espere até amanhã.</strong> Nossa equipe atende emergências odontológicas a qualquer hora — madrugada, feriados e fins de semana.
      </p>

      <!-- CTA GIGANTE -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://wa.me/5512991843883?text=URGÊNCIA%20-%20Preciso%20de%20atendimento%20odontológico%20de%20emergência%20AGORA!"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-center gap-3 bg-green-500 hover:bg-green-400 text-white font-black px-10 py-5 rounded-2xl text-xl transition-all duration-200 hover:scale-105 shadow-2xl shadow-green-900"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          CHAMAR AGORA NO WHATSAPP
        </a>
        <a
          href="tel:+5512991843883"
          class="flex items-center justify-center gap-3 border-2 border-red-500 text-red-300 hover:bg-red-600 hover:text-white font-bold px-8 py-5 rounded-2xl text-xl transition-all duration-200"
        >
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          (12) 99184-3883
        </a>
      </div>

      <!-- Localização -->
      <p class="mt-8 text-slate-400 text-sm">
        📍 R. Cel. João Cursino, 185 — Vila Adyana, São José dos Campos - SP
      </p>
    </div>

    <!-- Linha de alerta no bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-red-500 animate-pulse"></div>
  </section>

  <!-- O QUE ATENDEMOS -->
  <section class="py-16 bg-navy-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-3">Emergências que atendemos</h2>
        <p class="text-slate-400 text-lg">Qualquer situação de urgência odontológica, a qualquer hora</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {emergencies.map(item => (
          <div class="bg-navy-800 border border-red-900 rounded-2xl p-6 hover:border-red-500 transition-colors">
            <div class="text-3xl mb-3" aria-hidden="true">{item.icon}</div>
            <h3 class="text-white font-bold text-lg mb-2">{item.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCEDIMENTOS DE URGÊNCIA -->
  <section class="py-16 bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-black text-white mb-10 text-center">Procedimentos de Emergência</h2>

      <div class="space-y-6">
        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Atendimento de Urgência 24 Horas</h3>
          <p class="text-slate-400 leading-relaxed">Nosso plantão funciona 24 horas por dia, 7 dias por semana, incluindo feriados. Um dentista especializado está disponível para avaliação e tratamento imediato de dores e emergências odontológicas. O primeiro contato é feito via WhatsApp ou telefone, onde orientamos o paciente e agendamos o atendimento com máxima urgência.</p>
        </article>

        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Tratamento de Abscesso Dentário</h3>
          <p class="text-slate-400 leading-relaxed">O abscesso dentário é uma infecção grave que pode se espalhar rapidamente se não tratada. Realizamos drenagem do abscesso, tratamento endodôntico (canal) de emergência quando necessário, e prescrevemos antibioticoterapia adequada. Não ignore inchaços com dor pulsante — procure atendimento imediato.</p>
        </article>

        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Reimplante Dental Pós-Trauma</h3>
          <p class="text-slate-400 leading-relaxed">Se um dente foi completamente arrancado por trauma (avulsão), a velocidade é decisiva. Preserve o dente em leite, soro fisiológico ou na própria saliva — nunca em água. Procure atendimento em até 30 a 60 minutos para que o reimplante seja viável. Realizamos splintagem e acompanhamento pós-reimplante.</p>
        </article>

        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Fratura Dental e Dental</h3>
          <p class="text-slate-400 leading-relaxed">Fraturas coronárias (na parte visível do dente), radiculares (na raiz) ou dentoalveolares (envolvendo o osso) exigem avaliação e tratamento imediatos. Realizamos restauração de emergência, tratamento endodôntico quando há exposição pulpar, e planejamos a reabilitação definitiva com urgência.</p>
        </article>

        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Tratamento de Pericoronarite</h3>
          <p class="text-slate-400 leading-relaxed">A pericoronarite ocorre quando o tecido gengival ao redor de um siso em erupção se inflama, causando dor intensa, inchaço e dificuldade para abrir a boca ou engolir. O tratamento inclui irrigação e limpeza local, antibióticos quando necessário e, nos casos recorrentes, indicação de exodontia do siso.</p>
        </article>

        <article class="bg-navy-800 border-l-4 border-red-500 rounded-r-2xl p-6">
          <h3 class="text-xl font-bold text-white mb-2">Dor de Dente Severa</h3>
          <p class="text-slate-400 leading-relaxed">Dor dental intensa pode ter múltiplas causas: pulpite irreversível, fratura, cárie profunda, periodontite aguda. O diagnóstico correto é essencial para o tratamento adequado. Realizamos avaliação clínica e radiográfica de emergência, com alívio imediato da dor através do tratamento específico de cada caso.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA FINAL URGÊNCIA -->
  <section class="bg-red-700 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="flex justify-center mb-4">
        <span class="relative flex h-5 w-5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-300 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-5 w-5 bg-red-200"></span>
        </span>
      </div>
      <h2 class="text-3xl font-black text-white mb-3">Está com dor agora?</h2>
      <p class="text-red-100 text-lg mb-6">Não espere. Nossa equipe está de plantão pronta para te atender.</p>
      <a
        href="https://wa.me/5512991843883?text=URGÊNCIA%20-%20Preciso%20de%20atendimento%20odontológico%20de%20emergência%20AGORA!"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-400 text-white font-black px-10 py-4 rounded-2xl text-xl transition-all hover:scale-105 shadow-xl"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        CHAMAR NO WHATSAPP AGORA
      </a>
    </div>
  </section>
</Layout>
