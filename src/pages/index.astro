---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';

const testimonials = [
  { name: 'Maytê', date: 'Há 2 semanas', full: 'Melhor clínica Odontologica e estética de São José dos Campos, já faço tratamento odontologico e procedimentos há alguns anos. A Dra. Gabriela além de ser uma querida, é uma baita profissional e muito qualificada. Indico de olhos fechados.', isLong: false },
  { name: 'Ava Vaz', date: 'Há 7 semanas', full: 'Lugar confiável, Dra Gabriela faz um trabalho incrível, atenta aos detalhes e muito qualificada! Minha dentista e também quem administra a saúde da minha pele, botox, bioestimulador etc!', isLong: false },
  { name: 'André Bacelar', date: 'Há 8 semanas', full: 'Clínica odontológica espetacular, profissionais extraordinários! Minha irmã é especial e necessita de um tratamento diferenciado, aqui encontramos os profissionais certos, com muita paciência e um carinho fora de série!', isLong: false },
  { name: 'Priscila Martello', date: 'Há 8 semanas', full: 'Minha experiência na Clínica Reali foi excelente! Desde o primeiro contato fui muito bem atendida. A recepção é sempre muito atenciosa, educada e prestativa, fazendo com que a gente se sinta acolhido desde a chegada. A Dra. Gabriela é uma profissional incrível, muito competente, cuidadosa e transmite muita segurança. Ela explica tudo com calma, tira todas as dúvidas e realmente se preocupa com o bem-estar dos pacientes. É nítido o carinho e o profissionalismo de toda a equipe. Recomendo a Clínica Reali de olhos fechados para quem procura um atendimento de qualidade, confiança e um ambiente acolhedor. Estão todos de parabéns!', isLong: true },
  { name: 'Grace Estefania', date: 'Há 8 semanas', full: 'Gostaria de registrar minha excelente experiência com esta clínica odontológica. Ao longo do tempo realizei diversos procedimentos, como limpeza, tratamento ortodôntico, clareamento dental e implante dentário e em todos fui muito bem atendida. A equipe é extremamente atenciosa, profissional e cuidadosa, sempre explicando cada etapa do tratamento e transmitindo segurança. Estou muito satisfeita com os resultados obtidos e recomendo a clínica de olhos fechados para quem procura um atendimento de qualidade, profissionais competentes e um ambiente acolhedor. Sem dúvida, foi a melhor escolha para cuidar da minha saúde bucal.', isLong: true },
  { name: 'Regiane Peterson', date: 'Há 15 semanas', full: 'Eu só tenho a agradecer por ter encontrado a Dra Gabriela e a Dra Thaís, pois eu tenho pânico de dentista e elas foram super atenciosas comigo, cuidaram muito bem de mim e sempre garantindo que eu estivesse calma e relaxada. Além de super profissionais, o trabalho que fazem é espetacular, sem nenhum desconforto ou dor! Eu super recomendo o trabalho e atendimento da Clínica Reali.', isLong: true },
  { name: 'Maria Alcista', date: 'Há 17 semanas', full: 'A Clínica é excelente, com ótimos profissionais, em especial Dra Gabriela, com quem já realizei vários procedimentos. Indico com segurança.', isLong: false }
];

const faqSchema = [
  { question: 'Onde fica a Clínica Reali em São José dos Campos?', answer: 'A Clínica Reali está localizada na R. Cel. João Cursino, 185, no bairro Vila Adyana, São José dos Campos — SP, CEP 12243-680.' },
  { question: 'Quais tratamentos odontológicos a Clínica Reali oferece?', answer: 'A clínica reúne implantes e próteses, harmonização orofacial, Botox, preenchimentos, estética dental, clareamento, facetas, lentes, ortodontia, periodontia, endodontia e outros tratamentos odontológicos.' },
  { question: 'A Clínica Reali realiza harmonização orofacial?', answer: 'Sim. Entre os procedimentos estão toxina botulínica, preenchimento labial e facial, bioestimuladores de colágeno e outros procedimentos de harmonização orofacial, conforme avaliação profissional.' },
  { question: 'Como funciona a avaliação para implante dentário?', answer: 'A avaliação começa com exame clínico e, quando indicado, exames de imagem para analisar as condições ósseas e definir o planejamento do tratamento.' }
];
---

<Layout
  title="Clínica Odontológica em São José dos Campos — Vila Adyana"
  description="Clínica Reali Odontologia e Estética em São José dos Campos — SP. Implantes dentários, harmonização orofacial e urgência odontológica 24h em Vila Adyana. Nota 4.9 no Google. (12) 99184-3883."
  canonical={siteUrl}
  {faqSchema}
>
  <!-- HERO -->
  <section class="bg-slate-900 py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-5">
          Clínica Odontológica em<br/>
          <span class="text-emerald-400">São José dos Campos</span>
        </h1>

        <p class="text-slate-300 text-lg leading-relaxed mb-8">
          Implantes dentários, harmonização orofacial, Botox, estética dental e tratamentos odontológicos para diferentes necessidades. Na Vila Adyana, em São José dos Campos — SP.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="https://wa.me/5512991843883?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20consulta%20na%20Cl%C3%ADnica%20Reali!"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Agendar Consulta
          </a>
          <a href="/estetica-e-harmonizacao" class="inline-flex items-center justify-center gap-2 border border-slate-600 text-slate-300 hover:border-slate-400 hover:text-white font-medium px-6 py-3 rounded-lg transition-colors">Conhecer tratamentos estéticos</a>
        </div>

        <p class="mt-6 text-slate-500 text-sm">
          R. Cel. João Cursino, 185 — Vila Adyana, São José dos Campos — SP
        </p>
      </div>
    </div>
  </section>

  <!-- RATING STRIP -->
  <section class="border-b border-slate-200 bg-slate-50 py-4" aria-label="Avaliação no Google">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12">
        <div class="flex items-center gap-3">
          <div class="flex" aria-label="4.9 de 5 estrelas">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-slate-900 font-semibold text-sm"><strong>4.9</strong> no Google</span>
          <span class="text-slate-500 text-sm">· 57 avaliações de pacientes</span>
        </div>
        <div class="hidden sm:block w-px h-6 bg-slate-300"></div>
        <div class="flex items-center gap-6 text-sm text-slate-500">
          <span><strong class="text-slate-900">+10</strong> Especialidades</span>
          <span>Vila Adyana, <strong class="text-slate-900">SJC</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="text-emerald-700 text-sm font-semibold uppercase tracking-wider mb-2">Especialidades</p>
        <h2 class="text-3xl font-bold text-slate-900">Tratamentos disponíveis na Clínica Reali</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href="/implantes-e-proteses" class="group block border border-slate-200 rounded-xl p-6 hover:border-emerald-300 hover:bg-slate-50 transition-all">
          <div class="w-10 h-10 bg-emerald-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-emerald-100 transition-colors">
            <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C8.5 2 5.5 4.8 5.5 9c0 2.8 1.4 5.2 3.5 6.7L8 22l4-1.3 4 1.3-1-6.3C17.1 14.2 18.5 11.8 18.5 9 18.5 4.8 15.5 2 12 2z"/>
            </svg>
          </div>
          <h3 class="text-slate-900 font-semibold mb-1 group-hover:text-emerald-700 transition-colors">Implantes e Próteses</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Implante unitário, All-on-4, All-on-6, carga imediata e implante zigomático.</p>
          <span class="mt-3 inline-block text-emerald-700 text-sm font-medium">Saiba mais &rarr;</span>
        </a>

        <a href="/estetica-e-harmonizacao" class="group block border border-slate-200 rounded-xl p-6 hover:border-emerald-300 hover:bg-slate-50 transition-all">
          <div class="w-10 h-10 bg-emerald-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-emerald-100 transition-colors">
            <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
            </svg>
          </div>
          <h3 class="text-slate-900 font-semibold mb-1 group-hover:text-emerald-700 transition-colors">Estética e Harmonização</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Harmonização orofacial, lentes de contato dental, facetas e clareamento.</p>
          <span class="mt-3 inline-block text-emerald-700 text-sm font-medium">Saiba mais &rarr;</span>
        </a>

        <a href="/odontologia-geral" class="group block border border-slate-200 rounded-xl p-6 hover:border-emerald-300 hover:bg-slate-50 transition-all">
          <div class="w-10 h-10 bg-emerald-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-emerald-100 transition-colors">
            <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3 class="text-slate-900 font-semibold mb-1 group-hover:text-emerald-700 transition-colors">Odontologia Geral</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Consultas, restaurações, canal, periodontia, ortodontia, próteses e outros tratamentos.</p>
          <span class="mt-3 inline-block text-emerald-700 text-sm font-medium">Saiba mais &rarr;</span>
        </a>

        
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="aspect-[4/3] bg-slate-200 rounded-xl overflow-hidden flex items-center justify-center">
            <div class="text-center text-slate-400 p-8">
              <svg class="w-12 h-12 mx-auto mb-2 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <p class="text-sm">sobre-nos.webp</p>
            </div>
          </div>
        </div>
        <div>
          <p class="text-emerald-700 text-sm font-semibold uppercase tracking-wider mb-2">Sobre a Clínica</p>
          <h2 class="text-3xl font-bold text-slate-900 mb-5">Odontologia e estética na Vila Adyana</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>A <strong class="text-slate-800">Clínica Reali Odontologia e Estética</strong> está localizada na R. Cel. João Cursino, 185, na Vila Adyana, em São José dos Campos — SP. A clínica reúne tratamentos odontológicos, implantes, estética dental e procedimentos de harmonização orofacial no mesmo endereço.</p>
            <p>A <strong class="text-slate-800">Dra. Gabriela</strong> atua nos tratamentos odontológicos e procedimentos estéticos realizados na clínica, com avaliação individual para definir a indicação de cada procedimento.</p>
            <p>O atendimento inclui desde tratamentos clínicos e reabilitação com implantes até procedimentos como Botox, preenchimento, facetas, lentes de contato dental e clareamento.</p>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-3">
            {[
              { label: 'Nota 4.9 no Google' },
              { label: 'Planejamento digital 3D' },
              { label: 'Atendimento humanizado' },
            ].map(item => (
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {item.label}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DEPOIMENTOS -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-emerald-700 text-sm font-semibold uppercase tracking-wider mb-2">Avaliações reais</p>
        <div class="flex flex-col sm:flex-row sm:items-end gap-3">
          <h2 class="text-3xl font-bold text-slate-900">O que nossos pacientes dizem</h2>
          <a href="https://maps.app.goo.gl/2AH4j41vCoMBEBgR8" target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-700 hover:text-emerald-800 font-medium sm:mb-1 transition-colors">Ver todas no Google &rarr;</a>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <div class="flex">{[1,2,3,4,5].map(() => (<svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>))}</div>
          <span class="text-slate-500 text-sm">4.9 · 57 avaliações no Google</span>
        </div>
      </div>

      <div id="testimonials-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {testimonials.map((t, i) => (
          <article class="testimonial-card border border-slate-200 rounded-xl p-6 flex flex-col" data-index={String(i)}>
            <div class="flex items-center gap-1 mb-3">
              {[1,2,3,4,5].map(() => (<svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>))}
            </div>
            <blockquote class="text-slate-600 text-sm leading-relaxed flex-1">
              <p class="line-clamp-4">{t.full}</p>
            </blockquote>
            {t.isLong && (
              <button class="read-more-btn mt-3 text-emerald-700 hover:text-emerald-800 text-sm font-medium text-left transition-colors" data-index={String(i)} aria-label={`Ler avaliação completa de ${t.name}`}>
                Ler avaliação completa &rarr;
              </button>
            )}
            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <div class="text-slate-900 font-semibold text-sm">{t.name}</div>
                <div class="text-slate-400 text-xs">{t.date}</div>
              </div>
              <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            </div>
          </article>
        ))}
      </div>

      <div class="flex items-center justify-center gap-3 mt-8">
        <button id="prev-btn" class="w-9 h-9 rounded-full border border-slate-300 text-slate-500 hover:border-emerald-500 hover:text-emerald-700 flex items-center justify-center transition-colors" aria-label="Anterior">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <div id="carousel-dots" class="flex gap-1.5" role="tablist"></div>
        <button id="next-btn" class="w-9 h-9 rounded-full border border-slate-300 text-slate-500 hover:border-emerald-500 hover:text-emerald-700 flex items-center justify-center transition-colors" aria-label="Próximo">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- MODAL -->
  <div id="review-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-name">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modal-overlay"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6 md:p-8 max-h-[80vh] overflow-y-auto">
      <button id="modal-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 transition-colors" aria-label="Fechar">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="flex items-center gap-1 mb-1">
