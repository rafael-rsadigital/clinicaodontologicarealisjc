  <script define:vars={{ testimonials }}>
    (function() {
      const cards = Array.from(document.querySelectorAll('.testimonial-card'));
      let perPage = getPerPage();
      let currentPage = 0;
      function getPerPage() { return window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1; }
      function totalPages() { return Math.ceil(cards.length / perPage); }
      function showPage(page) {
        currentPage = Math.max(0, Math.min(page, totalPages() - 1));
        const start = currentPage * perPage;
        cards.forEach((card, i) => {
          const vis = i >= start && i < start + perPage;
          card.style.display = vis ? 'flex' : 'none';
          card.style.flexDirection = 'column';
        });
        renderDots();
        const prev = document.getElementById('prev-btn');
        const next = document.getElementById('next-btn');
        if (prev) (prev as HTMLButtonElement).disabled = currentPage === 0;
        if (next) (next as HTMLButtonElement).disabled = currentPage >= totalPages() - 1;
      }
      function renderDots() {
        const dc = document.getElementById('carousel-dots');
        if (!dc) return;
        dc.innerHTML = '';
        for (let i = 0; i < totalPages(); i++) {
          const d = document.createElement('button');
          d.className = 'w-2 h-2 rounded-full transition-colors ' + (i === currentPage ? 'bg-emerald-700' : 'bg-slate-300 hover:bg-slate-400');
          d.setAttribute('aria-label', 'Ir para página ' + (i + 1));
          const idx = i;
          d.addEventListener('click', () => showPage(idx));
          dc.appendChild(d);
        }
      }
      document.getElementById('prev-btn')?.addEventListener('click', () => showPage(currentPage - 1));
      document.getElementById('next-btn')?.addEventListener('click', () => showPage(currentPage + 1));
      window.addEventListener('resize', () => { const np = getPerPage(); if (np !== perPage) { perPage = np; showPage(0); } });
      showPage(0);

      const modal = document.getElementById('review-modal');
      const modalName = document.getElementById('modal-name');
      const modalDate = document.getElementById('modal-date');
      const modalText = document.getElementById('modal-text');
      function openModal(index) {
        const t = testimonials[index];
        if (!t || !modal || !modalName || !modalDate || !modalText) return;
        modalName.textContent = t.name;
        modalDate.textContent = t.date;
        modalText.textContent = t.full;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function closeModal() { modal?.classList.add('hidden'); document.body.style.overflow = ''; }
      document.querySelectorAll('.read-more-btn').forEach(btn => {
        btn.addEventListener('click', () => { openModal(parseInt(btn.dataset.index || '0', 10)); });
      });
      document.getElementById('modal-close')?.addEventListener('click', closeModal);
      document.getElementById('modal-overlay')?.addEventListener('click', closeModal);
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

      document.querySelectorAll('.faq-question').forEach(btn => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('.faq-icon');
          const isOpen = answer && !answer.classList.contains('hidden');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
          document.querySelectorAll('.faq-icon').forEach(ic => { (ic as HTMLElement).style.transform = 'rotate(0deg)'; });
          document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded', 'false'));
          if (!isOpen && answer) { answer.classList.remove('hidden'); if (icon) (icon as HTMLElement).style.transform = 'rotate(45deg)'; btn.setAttribute('aria-expanded', 'true'); }
        });
      });
    })();
  </script>
