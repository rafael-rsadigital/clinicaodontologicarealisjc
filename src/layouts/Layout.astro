---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/og-image.webp',
  faqSchema = [],
} = Astro.props;

const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const fullTitle = `${title} | Clínica Reali Odontologia e Estética`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Dentist", "LocalBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "Clínica Reali Odontologia e Estética",
      "description": "Clínica odontológica em São José dos Campos, com foco em implantes dentários, harmonização orofacial, estética dental e tratamentos odontológicos. Vila Adyana — SP.",
      "url": siteUrl,
      "telephone": "+55-12-99184-3883",
      "image": `${siteUrl}/images/og-image.webp`,
      "logo": `${siteUrl}/favicon.svg`,
      "priceRange": "$$",
      "currenciesAccepted": "BRL",
      "paymentAccepted": "Dinheiro, Cartão de Crédito, Cartão de Débito, Pix",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Cel. João Cursino, 185",
        "addressLocality": "São José dos Campos",
        "addressRegion": "SP",
        "postalCode": "12243-680",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -23.202883679047762,
        "longitude": -45.8977618246807
      },
      "openingHours": [
        "Mo-Fr 09:00-18:00",
        "Sa 09:00-13:00"
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "57",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://instagram.com/clinicarealisjc",
        "https://maps.app.goo.gl/2AH4j41vCoMBEBgR8"
      ],
      "hasMap": "https://maps.app.goo.gl/2AH4j41vCoMBEBgR8",
      "medicalSpecialty": ["Implantologia","Harmonização Orofacial","Ortodontia","Periodontia","Endodontia","Estética Dental"],
      "areaServed": {
        "@type": "City",
        "name": "São José dos Campos",
        "containedInPlace": {
          "@type": "State",
          "name": "São Paulo"
        }
      },
      "founder": {
        "@type": "Person",
        "name": "Dra. Gabriela Reali",
        "jobTitle": "Cirurgiã-Dentista"
      }
    }
  ]
};

const faqPageSchema = faqSchema.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSchema.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
