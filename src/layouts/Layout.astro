---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/og-image.webp',
} = Astro.props;

const siteUrl = 'https://clinicaodontologicarealisjc.vercel.app';
const fullTitle = `${title} | Clínica Reali Odontologia e Estética`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Dentist", "MedicalBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "Clínica Reali Odontologia e Estética",
      "description": "Clínica odontológica completa em São José dos Campos com atendimento de urgência 24h, implantes, harmonização orofacial e muito mais.",
      "url": siteUrl,
      "telephone": "+55-12-99184-3883",
      "email": "",
      "image": `${siteUrl}/images/og-image.webp`,
      "logo": `${siteUrl}/favicon.svg`,
      "priceRange": "$$",
      "currenciesAccepted": "BRL",
      "paymentAccepted": "Cash, Credit Card, Debit Card, Pix",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Cel. João Cursino, 185",
        "addressLocality": "São José dos Campos",
        "addressRegion": "SP",
        "postalCode": "12243-680",
        "addressCountry": "BR",
        "addressArea": "Vila Adyana"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -23.202883679047762,
        "longitude": -45.8977618246807
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "57",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://instagram.com/clinicarealisjc",
        "https://maps.app.goo.gl/2AH4j41vCoMBEBgR8"
      ],
      "hasMap": "https://maps.app.goo.gl/2AH4j41vCoMBEBgR8",
      "medicalSpecialty": [
        "Implantologia",
        "Harmonização Orofacial",
        "Ortodontia",
        "Periodontia",
        "Endodontia",
        "Odontopediatria",
        "Estética Dental",
        "Urgência Odontológica 24h"
      ],
      "areaServed": {
        "@type": "City",
        "name": "São José dos Campos",
        "containedInPlace": {
          "@type": "State",
          "name": "São Paulo"
        }
      }
    }
  ]
};
